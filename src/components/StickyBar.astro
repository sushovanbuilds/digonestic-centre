---
import { centre } from '../config/index';
import { ui, t } from '../config/ui';
import type { Lang } from '../config/types';
import { getGeneralWhatsAppUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const whatsappUrl = getGeneralWhatsAppUrl(lang);
const cleanPhone = centre.contact.phone.replace(/\s+/g, '');
---

<aside id="sticky-bar" class="sticky-action-bar" aria-label="Quick actions">
  <div class="sticky-bar-inner">
    <a
      href={whatsappUrl}
      class="btn btn-wa sticky-btn"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="whatsapp" class="btn-icon" />
      <span>{t(ui.whatsappUs, lang)}</span>
    </a>

    <a href={`tel:${cleanPhone}`} class="btn btn-outline sticky-btn">
      <Icon name="phone" class="btn-icon" />
      <span>{t(ui.call, lang)}</span>
    </a>
  </div>
</aside>

<style>
  .sticky-action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--rule);
    padding: var(--space-8) var(--space-16) calc(var(--space-8) + env(safe-area-inset-bottom, 0px));
    box-shadow: 0 -4px 16px rgba(15, 36, 48, 0.08);
  }

  .sticky-bar-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    max-width: 480px;
    margin: 0 auto;
  }

  .sticky-btn {
    min-height: 48px;
    padding: 0 var(--space-16);
    font-size: 0.9375rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    white-space: nowrap;
  }

  @media (max-width: 400px) {
    .sticky-btn {
      padding: 0 var(--space-8);
      font-size: 0.875rem;
      gap: 6px;
    }
  }
</style>
