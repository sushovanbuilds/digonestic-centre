---
import { centre } from '../config/index';
import { ui, t } from '../config/ui';
import type { Lang } from '../config/types';
import { getDoctorWhatsAppUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
---

<div class="doctor-hours-wrapper">
  <div class="doctor-heading-row">
    <Icon name="user" class="doctor-title-icon" />
    <h3 class="doctor-hours-heading">{t(ui.doctorConsultations, lang)}</h3>
    {centre.flags.isDemo && (
      <span class="sample-tag demo-tag">{t(ui.demoData, lang)}</span>
    )}
  </div>

  <div class="doctor-table-card">
    <div class="doctor-list">
      {centre.doctors.map((doc) => {
        const docName = t(doc.name, lang);
        const docSpeciality = t(doc.speciality, lang);
        const docDays = t(doc.days, lang);
        const docWaUrl = getDoctorWhatsAppUrl(docName, docSpeciality, docDays, lang);

        return (
          <div class="doctor-row">
            <div class="doctor-info-grid">
              <span class="doctor-name">{docName}</span>
              <span class="doctor-speciality">{docSpeciality}</span>
              <span class="doctor-days">{docDays}</span>
            </div>
            <div class="doctor-action-cell">
              <a
                href={docWaUrl}
                class="btn btn-outline doctor-btn"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="whatsapp" class="btn-icon" />
                <span>{t(ui.bookConsultation, lang)}</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>

<style>
  .doctor-hours-wrapper {
    margin-top: var(--space-48);
  }

  .doctor-heading-row {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }

  .doctor-title-icon {
    width: 22px;
    height: 22px;
    color: var(--primary);
  }

  .doctor-hours-heading {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
    color: var(--ink);
  }

  .doctor-table-card {
    background-color: #ffffff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .doctor-list {
    display: flex;
    flex-direction: column;
  }

  .doctor-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding: var(--space-16) var(--space-20);
    border-bottom: 1px solid var(--rule);
  }

  .doctor-row:last-child {
    border-bottom: none;
  }

  @media (min-width: 768px) {
    .doctor-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .doctor-info-grid {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  @media (min-width: 768px) {
    .doctor-info-grid {
      display: grid;
      grid-template-columns: 220px 180px 1fr;
      align-items: center;
      gap: var(--space-16);
    }
  }

  .doctor-name {
    font-weight: 600;
    color: var(--ink);
    font-size: 1rem;
  }

  .doctor-speciality {
    font-size: var(--font-size-small);
    color: var(--ink-soft);
  }

  .doctor-days {
    font-size: var(--font-size-small);
    color: var(--ink-soft);
  }

  .doctor-action-cell {
    display: flex;
    width: 100%;
  }

  @media (min-width: 768px) {
    .doctor-action-cell {
      width: auto;
    }
  }

  .doctor-btn {
    min-height: 48px;
    padding: 0 var(--space-16);
    font-size: var(--font-size-small);
    white-space: nowrap;
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .doctor-btn {
      width: auto;
    }
  }
</style>
