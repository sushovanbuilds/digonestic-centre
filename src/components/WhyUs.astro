---
import { centre } from '../config/centre';
import { ui, t } from '../config/ui';
import type { Lang } from '../config/types';
import Icon from './Icon.astro';
import TextAnimation from './islands/TextAnimation';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
---

<section id="why-us" class="why-section">
  <div class="container">
    <TextAnimation
      client:visible
      text={t(ui.whyChooseUs, lang)}
      className="why-title"
    />

    <div class="why-cards-grid">
      {centre.why.map((item) => {
        const itemTitle = t(item.title, lang);
        const itemText = t(item.text, lang);

        return (
          <div class="why-card">
            <div class="why-icon-tile">
              <Icon name={item.icon} class="why-icon" />
            </div>
            <div class="why-card-text">
              <h3 class="why-card-title">{itemTitle}</h3>
              <p class="why-card-description">{itemText}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .why-section {
    background-color: var(--paper);
    border-top: 1px solid var(--rule);
  }

  :global(.why-title) {
    margin-bottom: var(--space-32);
  }

  /* 2x2 grid on desktop, 1 col on mobile */
  .why-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-20);
  }

  @media (min-width: 640px) {
    .why-cards-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-24);
    }
  }

  .why-card {
    background-color: #ffffff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: var(--space-20);
    display: flex;
    align-items: flex-start;
    gap: var(--space-16);
  }

  /* 40px icon tile */
  .why-icon-tile {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 8px;
    background-color: var(--tint);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .why-card-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .why-card-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ink);
  }

  .why-card-description {
    font-size: var(--font-size-small);
    color: var(--ink-soft);
    line-height: 1.5;
  }
</style>
