---
import { centre } from '../config/centre';
import { ui, t } from '../config/ui';
import type { Lang } from '../config/types';
import TextAnimation from './islands/TextAnimation';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const slots = Array.from({ length: centre.reviewSlots }, (_, i) => i + 1);
---

<section id="reviews" class="reviews-section">
  <div class="container">
    <TextAnimation
      client:visible
      text={t(ui.reviews, lang)}
      className="reviews-title"
    />

    <div class="reviews-grid">
      {slots.map((slot) => (
        <div class="review-white-card">
          <div class="review-card-inner">
            <span class="review-quote-mark" aria-hidden="true">&ldquo;</span>
            <p class="review-label">
              {t(ui.reviewPlaceholder, lang)} {slot}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .reviews-section {
    background-color: var(--paper);
    border-top: 1px solid var(--rule);
  }

  :global(.reviews-title) {
    margin-bottom: var(--space-32);
  }

  /* 3 white cards on desktop, 1 col mobile */
  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-20);
  }

  @media (min-width: 640px) {
    .reviews-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .review-white-card {
    background-color: #ffffff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: var(--space-24);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 120px;
  }

  .review-card-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .review-quote-mark {
    font-size: 2rem;
    line-height: 1;
    color: var(--rule);
    font-family: serif;
  }

  .review-label {
    font-size: var(--font-size-small);
    color: var(--ink-soft);
    font-style: italic;
    margin: 0;
  }
</style>
