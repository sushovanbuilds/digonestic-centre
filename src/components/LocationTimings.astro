---
import { centre } from '../config/centre';
import { ui, t } from '../config/ui';
import type { Lang } from '../config/types';
import DoctorHours from './DoctorHours.astro';
import Icon from './Icon.astro';
import TextAnimation from './islands/TextAnimation';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const cleanPhone = centre.contact.phone.replace(/\s+/g, '');
---

<section id="location" class="location-section">
  <div class="container">
    <TextAnimation
      client:visible
      text={t(ui.locationAndTimings, lang)}
      className="location-title"
    />

    <!-- Two Cards Side by Side on Desktop -->
    <div class="location-cards-grid">
      <!-- Left Details Card -->
      <div class="loc-card">
        <!-- Static Tinted Map Placeholder Frame -->
        <div class="map-placeholder-frame" aria-hidden="true">
          <Icon name="pin" class="map-placeholder-icon" />
          <span class="map-placeholder-text">Map placeholder</span>
        </div>

        <div class="loc-card-body">
          <h3 class="loc-area-title">{t(centre.location.areaLabel, lang)}</h3>

          <address class="loc-address-lines">
            {centre.location.addressLines.map((line) => (
              <span>{t(line, lang)}</span>
            ))}
          </address>

          <div class="loc-phone-row">
            <Icon name="phone" class="phone-icon" />
            <a href={`tel:${cleanPhone}`} class="phone-link">
              {centre.contact.phone}
            </a>
          </div>

          <div class="loc-btn-wrap">
            <a
              href={centre.location.mapUrl}
              class="btn btn-outline full-width-btn"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="pin" class="btn-icon" />
              <span>{t(ui.openMaps, lang)}</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Working Hours Card -->
      <div class="loc-card">
        <h3 class="hours-card-title">{t(ui.workingHours, lang)}</h3>
        <p class="hours-card-subtitle">{t(ui.hours, lang)}</p>

        <table class="hours-ruled-table">
          <tbody>
            {centre.hours.map((h) => (
              <tr class="hours-table-row">
                <td class="hours-cell-label">{t(h.label, lang)}</td>
                <td class="hours-cell-value">{t(h.value, lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Doctor consultations below -->
    {centre.flags.doctorSchedule && <DoctorHours lang={lang} />}
  </div>
</section>

<style>
  .location-section {
    background-color: var(--paper);
    border-top: 1px solid var(--rule);
  }

  :global(.location-title) {
    margin-bottom: var(--space-32);
  }

  /* Two cards side by side from 768px/900px */
  .location-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-24);
  }

  @media (min-width: 768px) {
    .location-cards-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-32);
      align-items: stretch;
    }
  }

  .loc-card {
    background-color: #ffffff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: var(--space-24);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Static Tinted Map Placeholder Frame */
  .map-placeholder-frame {
    height: 140px;
    background-color: var(--tint);
    border: 1px dashed var(--rule);
    border-radius: var(--radius-row);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    margin-bottom: var(--space-20);
    color: var(--primary);
  }

  .map-placeholder-icon {
    width: 24px;
    height: 24px;
  }

  .map-placeholder-text {
    font-size: var(--font-size-small);
    color: var(--ink-soft);
    font-weight: 500;
  }

  .loc-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .loc-area-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
  }

  .loc-address-lines {
    font-style: normal;
    font-size: var(--font-size-small);
    color: var(--ink-soft);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .loc-phone-row {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--font-size-small);
    margin: var(--space-4) 0 var(--space-12);
  }

  .phone-icon {
    width: 18px;
    height: 18px;
    color: var(--primary);
  }

  .phone-link {
    color: var(--ink);
    text-decoration: underline;
    font-weight: 500;
  }

  .phone-link:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 2px;
  }

  .full-width-btn {
    width: 100%;
  }

  .btn-icon {
    width: 18px;
    height: 18px;
  }

  /* Right Working Hours Card */
  .hours-card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .hours-card-subtitle {
    font-size: var(--font-size-small);
    color: var(--ink-soft);
    margin-bottom: var(--space-20);
  }

  .hours-ruled-table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--rule);
  }

  .hours-table-row {
    border-bottom: 1px solid var(--rule);
  }

  .hours-cell-label {
    padding: var(--space-16) 0;
    font-weight: 600;
    color: var(--ink);
    font-size: var(--font-size-small);
    width: 40%;
  }

  .hours-cell-value {
    padding: var(--space-16) 0;
    color: var(--ink-soft);
    font-size: var(--font-size-small);
    text-align: right;
  }
</style>
