---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TestsPackages from '../components/TestsPackages.astro';
import WhyUs from '../components/WhyUs.astro';
import HomeCollection from '../components/HomeCollection.astro';
import LocationTimings from '../components/LocationTimings.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { centre } from '../config/index';
import type { Lang } from '../config/types';

interface Props {
  lang?: Lang;
  initialOpenTestId?: string;
}

const { lang = 'en', initialOpenTestId } = Astro.props;
---

<Base lang={lang}>
  <Header lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <TestsPackages lang={lang} initialOpenTestId={initialOpenTestId} />
    <WhyUs lang={lang} />
    {centre.flags.homeCollection && <HomeCollection lang={lang} />}
    <LocationTimings lang={lang} />
    {centre.flags.showReviews && <Reviews lang={lang} />}
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
