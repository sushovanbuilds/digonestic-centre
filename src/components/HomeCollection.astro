---
import { centre } from '../config/index';
import { ui, t } from '../config/ui';
import type { Lang } from '../config/types';
import { getHomeWhatsAppUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const homeCol = centre.homeCollection;
const whatsappUrl = getHomeWhatsAppUrl(lang);
---

{homeCol && centre.flags.homeCollection && (
  <section id="home-collection" class="home-collection-section">
    <div class="container">
      <div class="home-collection-panel">
        <div class="home-collection-text">
          <h2 class="home-collection-title">{t(homeCol.title, lang)}</h2>
          <p class="home-collection-description">{t(homeCol.text, lang)}</p>
        </div>
        <div class="home-collection-action">
          <a
            href={whatsappUrl}
            class="btn btn-wa home-col-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="whatsapp" class="btn-icon" />
            <span>{t(ui.whatsappUs, lang)}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .home-collection-section {
    background-color: var(--paper);
    border-top: 1px solid var(--rule);
  }

  .home-collection-panel {
    background-color: var(--tint);
    border: 1px solid #b5d5cf;
    border-radius: var(--radius-card);
    padding: var(--space-32);
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  @media (min-width: 768px) {
    .home-collection-panel {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-32);
    }
  }

  .home-collection-text {
    max-width: 600px;
  }

  .home-collection-title {
    font-size: 1.35rem;
    font-weight: 650;
    color: var(--ink);
    margin-bottom: var(--space-8);
  }

  .home-collection-description {
    font-size: var(--font-size-body);
    color: var(--ink-soft);
    margin: 0;
  }

  .home-collection-action {
    display: flex;
  }

  .home-col-btn {
    white-space: nowrap;
    min-width: 200px;
  }
</style>
