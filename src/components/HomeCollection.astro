---
import { centre, ui } from '../config/centre';
import { getGeneralWhatsAppUrl } from '../lib/whatsapp';

const lang = centre.lang;
const homeCol = centre.homeCollection;
const whatsappUrl = getGeneralWhatsAppUrl();
---

{homeCol && (
  <section id="home-collection" class="home-collection-section">
    <div class="container">
      <div class="home-collection-card">
        <div class="home-collection-content">
          <h2>{homeCol.title[lang] ?? homeCol.title.en}</h2>
          <p class="home-collection-text">{homeCol.text[lang] ?? homeCol.text.en}</p>
        </div>
        <div class="home-collection-action">
          <a
            href={whatsappUrl}
            class="btn btn-wa"
            target="_blank"
            rel="noopener noreferrer"
          >
            {ui.requestWhatsApp[lang] ?? ui.requestWhatsApp.en}
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .home-collection-section {
    background-color: var(--paper);
    border-top: 1px solid var(--rule);
  }

  .home-collection-card {
    background-color: var(--tint);
    border-radius: var(--radius-contact);
    padding: var(--space-32);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  @media (min-width: 768px) {
    .home-collection-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .home-collection-content h2 {
    margin-bottom: var(--space-12);
  }

  .home-collection-text {
    font-size: var(--font-size-body);
    color: var(--ink-soft);
  }

  .home-collection-action {
    display: flex;
  }
</style>
