---
import { centre } from '../config/index';
import { ui, t } from '../config/ui';
import type { Lang } from '../config/types';
import { getGeneralWhatsAppUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';
import Press from './islands/Press';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const whatsappUrl = getGeneralWhatsAppUrl(lang);
const tagline = t(centre.tagline, lang);

// CSS-only per-word reveal for H1 (0.6s, 50ms stagger, visible without JS)
const titleWords = centre.name.split(' ');
---

<section id="hero" class="hero-section">
  <div class="container hero-container">
    <div class="hero-main">
      <!-- Small Concept Preview Pill above H1 -->
      <div class="hero-pill-wrap">
        <span class="sample-tag hero-concept-pill">
          {t(ui.conceptPreview, lang)}
        </span>
      </div>

      <!-- H1 with CSS-only per-word reveal -->
      <h1 class="hero-heading">
        {titleWords.map((word, i) => (
          <span class="hero-word" style={`animation-delay: ${i * 50}ms`}>
            {word}&nbsp;
          </span>
        ))}
      </h1>

      <p class="hero-tagline">{tagline}</p>

      <!-- Two buttons stacked on mobile, side-by-side on tablet/desktop -->
      <div class="hero-actions">
        <Press client:visible>
          <a href="#tests" class="btn btn-primary hero-btn">
            <Icon name="calendar" class="btn-icon" />
            <span>{t(ui.bookTest, lang)}</span>
          </a>
        </Press>
        <Press client:visible>
          <a href={whatsappUrl} class="btn btn-wa hero-btn" target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" class="btn-icon" />
            <span>{t(ui.whatsappUs, lang)}</span>
          </a>
        </Press>
      </div>

      {centre.flags.isDemo ? (
        <p class="hero-notice">
          <span class="sample-tag demo-tag">{t(ui.demoData, lang)}</span> {t(ui.demoHeroNote, lang)}
        </p>
      ) : (
        <p class="hero-notice">{t(ui.heroSampleNote, lang)}</p>
      )}
    </div>

    <!-- Desktop Quick-Info Card (Stitch desktop match) -->
    <aside class="hero-sidebar" aria-label="Quick information">
      <div class="quick-info-card">
        <div class="quick-info-header">
          <span class="quick-info-label">{t(ui.quickInfo.title, lang)}</span>
        </div>

        <div class="quick-info-body">
          <div class="quick-info-row hours-row">
            <span class="row-label">
              <Icon name="clock" class="row-label-icon" />
              <span>{t(ui.quickInfo.hours, lang)}</span>
            </span>
            <div class="row-hours-list">
              {centre.hours.map((h) => (
                <div class="hour-item">
                  <span class="hour-label">{t(h.label, lang)}</span>
                  <span class="hour-value">{t(h.value, lang)}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="quick-info-row address-row">
            <span class="row-label">
              <Icon name="pin" class="row-label-icon" />
              <span>{t(ui.quickInfo.address, lang)}</span>
            </span>
            <address class="quick-info-address">
              <span class="quick-info-area">{t(centre.location.areaLabel, lang)}</span>
              {centre.location.addressLines.map((line) => (
                <span class="quick-info-line">{t(line, lang)}</span>
              ))}
            </address>
          </div>

          <div class="quick-info-row phone-row">
            <span class="row-label">
              <Icon name="phone" class="row-label-icon" />
              <span>{t(ui.quickInfo.phone, lang)}</span>
            </span>
            <a href={`tel:${centre.contact.phone.replace(/\s+/g, '')}`} class="quick-info-phone">
              <Icon name="phone" class="phone-inline-icon" />
              <span>{centre.contact.phone}</span>
            </a>
          </div>

          <div class="quick-info-action">
            <a href={centre.location.mapUrl} class="btn btn-outline quick-info-map-btn" target="_blank" rel="noopener noreferrer">
              <Icon name="pin" class="btn-icon" />
              <span>{t(ui.openMaps, lang)}</span>
            </a>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero-section {
    padding-top: var(--space-48);
    padding-bottom: var(--space-48);
  }

  @media (min-width: 900px) {
    .hero-section {
      padding-top: var(--space-72);
      padding-bottom: var(--space-72);
    }
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }

  @media (min-width: 900px) {
    .hero-container {
      display: grid;
      grid-template-columns: 7fr 5fr;
      align-items: start;
      gap: var(--space-48);
    }
  }

  .hero-main {
    max-width: 620px;
  }

  .hero-pill-wrap {
    margin-bottom: var(--space-12);
  }

  .hero-concept-pill {
    margin-bottom: 0;
  }

  /* CSS-only Per-word Keyframe Reveal */
  .hero-heading {
    margin: 0 0 var(--space-16) 0;
    font-size: var(--font-size-h1);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero-word {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-word {
      animation: hero-word-reveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes hero-word-reveal {
    from {
      opacity: 0.2;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--ink-soft);
    margin-bottom: var(--space-32);
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .hero-btn {
    width: 100%;
  }

  @media (min-width: 640px) {
    .hero-btn {
      width: auto;
      min-width: 180px;
    }
  }

  .hero-notice {
    font-size: var(--font-size-small);
    color: var(--ink-soft);
  }

  /* Desktop Quick Info Card */
  .hero-sidebar {
    display: none;
  }

  @media (min-width: 900px) {
    .hero-sidebar {
      display: block;
    }
  }

  .quick-info-card {
    background-color: #ffffff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: var(--space-20);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .quick-info-header {
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--rule);
  }

  .quick-info-label {
    font-size: var(--font-size-small);
    font-weight: 650;
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  .quick-info-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .quick-info-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: var(--font-size-small);
  }

  .row-label {
    color: var(--ink-soft);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .row-label-icon {
    width: 14px;
    height: 14px;
    color: var(--primary);
  }

  html[lang="bn"] .row-label {
    text-transform: none;
    letter-spacing: normal;
  }

  .row-hours-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hour-item {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-small);
  }

  .hour-label {
    color: var(--ink);
    font-weight: 500;
  }

  .hour-value {
    color: var(--ink-soft);
  }

  .quick-info-address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--ink-soft);
    font-size: var(--font-size-small);
  }

  .quick-info-area {
    color: var(--ink);
    font-weight: 600;
  }

  .quick-info-phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
  }

  .phone-inline-icon {
    width: 16px;
    height: 16px;
    color: var(--primary);
  }

  .quick-info-action {
    padding-top: var(--space-4);
  }

  .quick-info-map-btn {
    width: 100%;
    justify-content: center;
    font-size: var(--font-size-small);
  }
</style>
