---
import '@fontsource-variable/figtree';
import BengaliFont from '../components/BengaliFont.astro';
import { centre } from '../config/centre';
import { ui, t } from '../config/ui';
import type { Lang } from '../config/types';
import { getThemeStyleString } from '../lib/theme';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const {
  lang = 'en',
  title = centre.name,
  description = t(centre.tagline, lang),
} = Astro.props;

const themeStyle = getThemeStyleString();

const jsonLd = centre.flags.emitSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'MedicalClinic',
      name: centre.name,
      description: description,
      telephone: centre.contact.phone,
      address: {
        '@type': 'PostalAddress',
        streetAddress: centre.location.addressLines.map((l) => t(l, lang)).join(', '),
        addressLocality: t(centre.location.areaLabel, lang),
      },
    }
  : null;
---

<!doctype html>
<html lang={lang} style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="bn" href="/bn/" />
    {lang === 'bn' && <BengaliFont />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="schema" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t(ui.skipToContent, lang)}</a>
    <slot />
  </body>
</html>
