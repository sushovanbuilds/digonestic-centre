---
import { centre } from '../config/centre';
import { getThemeStyleString } from '../lib/theme';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = centre.name, description = centre.tagline[centre.lang] ?? centre.tagline.en } = Astro.props;
const themeStyle = getThemeStyleString();

const jsonLd = centre.flags.emitSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'MedicalClinic',
      name: centre.name,
      description: description,
      telephone: centre.contact.phone,
      address: {
        '@type': 'PostalAddress',
        streetAddress: centre.location.addressLines.join(', '),
        addressLocality: centre.location.areaLabel,
      },
    }
  : null;
---

<!doctype html>
<html lang={centre.lang} style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/figtree-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="schema" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
