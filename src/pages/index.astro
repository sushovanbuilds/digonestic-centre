---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TestsPackages from '../components/TestsPackages.astro';
import WhyUs from '../components/WhyUs.astro';
import HomeCollection from '../components/HomeCollection.astro';
import LocationTimings from '../components/LocationTimings.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { centre } from '../config/centre';
---

<Base>
  <Header />
  <main id="main-content">
    <Hero />
    <TestsPackages />
    <WhyUs />
    {centre.flags.homeCollection && <HomeCollection />}
    <LocationTimings />
    {centre.flags.showReviews && <Reviews />}
    <Contact />
  </main>
  <Footer />
</Base>
